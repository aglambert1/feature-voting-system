# Environment variables for the Feature Voting System backend
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=Feature Voting System
DEBUG=true

# Database Configuration
# For SQLite (simple, file-based - good for learning):
DATABASE_URL=sqlite:///./feature_voting.db

# For PostgreSQL (production-ready - use this later):
# DATABASE_URL=postgresql://username:password@localhost:5432/feature_voting_db

# Security Settings
# IMPORTANT: Generate a secure secret key with this command:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings (allowed frontend URLs)
# Add your frontend URL here, separated by commas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Initial Admin User (created automatically on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_FULL_NAME=System Administrator

# AI/LLM Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Development Mode OTP Settings
# SECURITY WARNING: Only use these in development environments!
# DEV_OTP_BYPASS: A fixed OTP code that always works when DEBUG=true (default: "000000")
# DEV_RETURN_OTP: Whether to return the OTP in API responses when DEBUG=true (default: true)
DEV_OTP_BYPASS=000000
DEV_RETURN_OTP=true
