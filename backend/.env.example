# Environment variables for the Feature Voting System backend
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED FOR ALL ENVIRONMENTS
# =============================================================================

# Security: Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# AI/LLM: Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# =============================================================================
# DEVELOPMENT SETTINGS (set these in your local .env)
# =============================================================================

# Set to true for local development (enables API docs, dev endpoints, etc.)
DEBUG=true

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./feature_voting.db
# DATABASE_URL=postgresql://username:password@localhost:5432/feature_voting_db

# Application
APP_NAME=Feature Voting System

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (allowed frontend URLs, comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Bootstrap admin user (created on first startup if set)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_FULL_NAME=System Administrator

# Search API (for competitor research)
# Get a free key at https://brave.com/search/api/
BRAVE_API_KEY=

# Redis/Celery (for background task processing)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# DEV-ONLY SETTINGS (only active when DEBUG=true)
# =============================================================================

# Fixed OTP code that always works in dev mode (leave empty to disable)
DEV_OTP_BYPASS=000000

# Return OTP in API responses for easy testing (set to true to enable)
DEV_RETURN_OTP=true
